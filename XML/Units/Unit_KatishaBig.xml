<?xml version="1.0" encoding="utf-8"?>
<!--
文件名: Unit_KatishaBig.xml
作用: 定义卡提希娅大卡形态（战争形态）的属性
用途: 在形态切换时使用此单位数据替代原有单位
-->
<GameData>
	<!-- 大卡单位定义 -->
	<Units>
		<Row>
			<Type>UNIT_KATISHA_BIG</Type>
			<!-- 大卡形态单位内部标识符 -->
			<Class>UNITCLASS_WARRIOR</Class>
			<!-- 单位类别，继承战士类别 -->
			<PrereqTech>TECH_BRONZE_WORKING</PrereqTech>
			<!-- 前置科技，青铜时代科技 -->
			<Combat>45</Combat>
			<!-- 初始战斗值较高，符合大卡战争形态 -->
			<Cost>40</Cost>
			<!-- 生产成本较低，因为是转化而来 -->
			<Moves>2</Moves>
			<!-- 移动力与小卡相同 -->
			<CombatClass>UNITCOMBAT_MELEE</CombatClass>
			<!-- 战斗类型，近战 -->
			<Domain>DOMAIN_LAND</Domain>
			<!-- 行动领域 -->
			<DefaultUnitAI>UNITAI_ATTACK</DefaultUnitAI>
			<!-- 默认AI行为改为攻击 -->
			<Description>TXT_KEY_UNIT_KATISHA_BIG_DESC</Description>
			<!-- 单位描述文本键 -->
			<Civilopedia>TXT_KEY_UNIT_KATISHA_BIG_PEDIA</Civilopedia>
			<!-- 单位百科全书文本键 -->
			<Strategy>TXT_KEY_UNIT_KATISHA_BIG_STRATEGY</Strategy>
			<!-- 单位战略提示文本键 -->
			<Help>TXT_KEY_UNIT_KATISHA_BIG_HELP</Help>
			<!-- 单位帮助文本键 -->
			<FortifyModifier>0</FortifyModifier>
			<WorkRate>0</WorkRate>
			<NumFreeLuxGood>0</NumFreeLuxGood>
			<LeaderExperience>0</LeaderExperience>
			<AdvancedStartCost>30</AdvancedStartCost>
			<Pillage>true</Pillage>
			<!-- 大卡可以掠夺地块 -->
			<FoundLakes>false</FoundLakes>
			<FoundCoast>false</FoundCoast>
			<FoundFreshWater>false</FoundFreshWater>
			<FoundAbroad>false</FoundAbroad>
			<BarbarianFree>false</BarbarianFree>
			<BarbarianCostScaling>false</BarbarianCostScaling>
			<AlwaysHeal>false</AlwaysHeal>
			<HurryCostModifier>-1</HurryCostModifier>
			<GoldPerTurnMaintenance>0</GoldPerTurnMaintenance>
			<IgnoreBuildingDefense>0</IgnoreBuildingDefense>
			<!-- 大卡不忽略建筑防御 -->
			<RangedStrike>false</RangedStrike>
			<PortraitIndex>1</PortraitIndex>
			<!-- 不同的头像索引 -->
			<IconAtlas>ABILITY_ATLAS</IconAtlas>
			<MoveRate>MOVE_RATE_NORMAL</MoveRate>
			<!-- 专属能力：可以使用终焉洪流技能 -->
			<Special>UNIT_SPECIAL_MELEE</Special>
			<UnitModel>Units/Katisha/KatishaBig.fxsxml</UnitModel>
		</Row>
	</Units>

	<!-- 大卡单位图片定义 -->
	<UnitGameplay2DScripts>
		<Row>
			<UnitType>UNIT_KATISHA_BIG</UnitType>
			<!-- 指定该单位的3D模型脚本 -->
			<FunctionName>UnitInitialize(Unit)</FunctionName>
		</Row>
	</UnitGameplay2DScripts>

	<!-- 大卡单位艺术定义 -->
	<UnitArtInfos>
		<Row>
			<Type>ART_DEF_UNIT_KATISHA_BIG</Type>
			<!-- 大卡艺术定义类型 -->
			<Nickname>"katisha_big_unit"</Nickname>
			<!-- 大卡单位昵称 -->
			<HotKey>None</HotKey>
			<WorldSoundscapeScriptId>AS3D_UNITIONS</WorldSoundscapeScriptId>
			<ScriptId>KatishaBigUnit</ScriptId>
			<Formation>FORMATION_TYPE_UNIQUE</Formation>
		</Row>
	</UnitArtInfos>

	<UnitArtInfoCulturalVariants>
		<Row>
			<UnitArtInfoType>ART_DEF_UNIT_KATISHA_BIG</UnitArtInfoType>
			<DomainType>DOMAIN_LAND</DomainType>
			<UnitFlagIconOffset>1</UnitFlagIconOffset>
			<Asset>Units/Katisha/KatishaBig.fxsxml</Asset>
			<!-- 大卡模型文件 -->
		</Row>
	</UnitArtInfoCulturalVariants>

	<!-- 大卡单位免费晋升 -->
	<Unit_FreePromotions>
		<Row>
			<UnitType>UNIT_KATISHA_BIG</UnitType>
			<PromotionType>PROMOTION_CAN_MOVE_AFTER_ATTACKING</PromotionType>
			<!-- 大卡形态可以攻击后移动 -->
		</Row>
		<Row>
			<UnitType>UNIT_KATISHA_BIG</UnitType>
			<PromotionType>PROMOTION_EXTRA_MOVES</PromotionType>
			<!-- 额外移动力 -->
		</Row>
		<Row>
			<UnitType>UNIT_KATISHA_BIG</UnitType>
			<PromotionType>PROMOTION_CITY_PENALTY</PromotionType>
			<!-- 对城市攻击有惩罚，避免过于强大 -->
		</Row>
		<Row>
			<UnitType>UNIT_KATISHA_BIG</UnitType>
			<PromotionType>PROMOTION_NO_DEFENSIVE_BONUS</PromotionType>
			<!-- 在开阔地带更强，城市中较弱 -->
		</Row>
	</Unit_FreePromotions>
</GameData>